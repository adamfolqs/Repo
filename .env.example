# ---- Which backend does the actual fetching ----
# playwright  = free, local browser. Brittle from datacenter IPs.
# brightdata  = paid, handles unblocking + maintained TikTok extractors.
TIKTOK_PROVIDER=playwright

# ---- Bright Data (only if TIKTOK_PROVIDER=brightdata) ----
BRIGHTDATA_API_TOKEN=

# ---- Google Sheets sink (only if you use --sink sheets) ----
# Path to a Google Cloud service-account JSON key.
# The target Sheet must be SHARED with that service account's email.
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json
GOOGLE_SHEET_ID=

# ---- Politeness / rate limiting ----
REQUEST_DELAY_SECONDS=2.5
MAX_RETRIES=3

# Optional: path to a pre-installed Chromium, when the sandbox ships one whose
# build number differs from the pip-installed playwright.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# =====================================================================
#  Weekly performance tracker  (python -m folqs_tracker run)
# =====================================================================

# ---- Claude: reads the analytics screenshots ----
ANTHROPIC_API_KEY=
TRACKER_MODEL=claude-opus-5

# ---- Where the tracker writes ----
# The Folqs TikTok Shop Wiki. The tab is transposed: each week is a COLUMN.
# Share this Sheet with the service account's client_email as an EDITOR.
FOLQS_WIKI_SHEET_ID=1exP-EUYUuTmQZevSn-jeg02sBJF9KHZUA4YU1abFJkE
FOLQS_WEEKLY_TAB=Weekly Performance (1)

# ---- Where "Samples Sent" is counted from ----
# The retainer sample tracker linked off the wiki's Homepage tab. Counts POs
# raised through the warehouse only, so it is a suggestion, not an authority.
SAMPLES_TRACKER_SHEET_ID=1e8OsOnI9smEnoDsnHARr8nB-qA7jDARoOtmQiiOao7Q
SAMPLES_TRACKER_TAB=Tracker

# ---- Screenshot inbox ----
TRACKER_SCREENSHOT_DIR=data/tracking/inbox
TRACKER_ARCHIVE_DIR=data/tracking/archive
TRACKER_SNAPSHOT_DIR=data/tracking/snapshots

# ---- Email digest ----
# Gmail needs an App Password (not your login password) with 2FA enabled:
# myaccount.google.com -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=adam@folqs.co

# ---- Telegram ----
# 1. Message @BotFather -> /newbot -> copy the token
# 2. Send your new bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy result[0].message.chat.id
#    (a bot cannot message you until you have messaged it first)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Automated screenshot capture ----
# Log in once by hand:  python -m folqs_tracker login
# Then record your account's real URLs:  python -m folqs_tracker calibrate
# No password is ever stored -- only the resulting browser session.
TIKTOK_SESSION_FILE=.tiktok_session.json
TRACKER_CAPTURE_PLAN=capture_plan.json
TRACKER_CAPTURE_HEADLESS=1

# Point at a pre-installed Chromium if the pip-installed playwright's build
# number does not match the browser on this machine.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
