__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
.pytest_cache/

# Secrets — never commit
service_account.json
credentials.json
token.json

# Scraped output is data, not source
data/output/*
!data/output/.gitkeep
!data/output/handle_lookup.csv
!data/output/found_videos.csv
!data/output/colostrum_creator_list.xlsx
.cache/

# Weekly tracker working files.
# Screenshots are dashboard captures and may carry customer/creator detail;
# logs and archives are noise. Snapshots ARE kept -- they are the numeric
# history, small, and worth diffing.
data/tracking/inbox/*
!data/tracking/inbox/.gitkeep
!data/tracking/inbox/README.md
data/tracking/archive/
data/tracking/logs/
